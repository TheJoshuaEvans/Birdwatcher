/* Styles for the Birdwatcher app (Textual CSS): a retro terminal look.
   Colors come from the theme ($accent, $error, ...); this file sets shapes.
   Double-line frames carry [ TITLES ]; chrome is in capitals. */

/* Header and buttons, everywhere */
Header {
    text-style: bold;
}

Button {
    border: none;
    height: 1;
    min-width: 0;
    padding: 0 1;
    text-style: bold;
}

Button:hover, Button:focus {
    text-style: bold reverse;
}

/* Findings view: two framed panes joined by the divider ("╦ ║ ╩") */
#findings-pane {
    width: 45%;
    border: double $accent;
    border-right: none;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $accent;
}

#detail-scroll {
    width: 1fr;
    padding: 0 1;
    border: double $accent;
    border-left: none;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $accent;
}

/* Grouping tabs: one line, the active one a solid block */
#grouping {
    height: 1;
    margin: 0 1;
}

#grouping Underline {
    display: none;
}

#grouping Tab {
    height: 1;
    padding: 0 1;
}

#grouping Tab.-active {
    background: $accent;
    color: $background;
    text-style: bold;
}

/* Chips: SHOW [X] ERROR 16  [X] WARNING 58  [ ] INFO 214, then FIXED and IGNORED */
#chips {
    height: auto;
    margin: 0 1;
}

.chip-row {
    height: auto;
}

.chip-label {
    width: 5;
    text-style: bold;
    color: $accent;
}

/* FIND: a flat one-line search box beside its label */
#find {
    border: none;
    height: 1;
    width: 1fr;
    padding: 0 1;
    background: $surface;
}

#find:focus {
    background: $boost;
    text-style: bold;
}

#chips StatusChip {
    border: none;
    padding: 0 1;
    background: transparent;
}

#findings {
    height: 1fr;
}

/* The [F] FIX marker at the end of a fixable row */
FindingsTree > .tree--fix {
    color: $success;
    text-style: bold;
}

/* The watch strip: what is being checked, at the bottom of the findings pane */
WatchStrip {
    display: none;
    height: auto;
    border-top: solid $accent;
    padding: 0 1;
}

#watch-status {
    width: 1fr;
}

#watch-status, #stop {
    height: 2;
}

#excerpt-scroll {
    height: auto;
}

#excerpt {
    width: auto;
}

/* The fix (or suggested fix) and its buttons, under the source lines */
#fix-summary {
    margin-top: 1;
}

#branch-list {
    margin-top: 1;
}

#actions {
    height: auto;
    margin-top: 1;
}

#actions Button {
    margin-right: 2;
}

/* Narrow windows (-narrow) show one pane at a time: the findings, or with z
   the detail as its own page. Zoom (-zoomed) shows only the detail at any
   width. A pane on its own closes its frame on the inner side. Zoom rules
   come after the narrow ones so they win when both apply. */
FindingsScreen.-narrow Divider,
FindingsScreen.-narrow #detail-scroll {
    display: none;
}

FindingsScreen.-narrow #findings-pane {
    border-right: double $accent;
}

FindingsScreen.-zoomed #findings-pane,
FindingsScreen.-zoomed Divider {
    display: none;
}

FindingsScreen.-zoomed #detail-scroll {
    display: block;
    border-left: double $accent;
}

/* The draggable divider: the shared wall of the two frames. The pointer
   shape shows only in terminals that support it (OSC 22). */
Divider {
    width: 1;
    height: 1fr;
    color: $accent;
    pointer: ew-resize;
}

Divider:hover, Divider.-dragging {
    color: $accent-lighten-2;
    background: $accent 30%;
}

/* The ignore dialog, centered over the findings */
IgnoreDialog, FixAllDialog, KeysDialog, ResetDialog {
    align: center middle;
}

/* A fixed width: a scrolling container with width auto collapses to nothing */
#keys-dialog {
    width: 80;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: double $accent;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $accent;
    background: $surface;
}

#keys-list {
    width: 1fr;
}

#ignore-dialog, #fix-all-dialog, #reset-dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    border: double $accent;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $accent;
    background: $surface;
}

#ignore-warning {
    color: $warning;
    text-style: bold;
    margin-top: 1;
}

#ignore-reason-label {
    margin-top: 1;
}

#ignore-buttons, #fix-all-buttons, #reset-buttons {
    height: auto;
    margin-top: 1;
}

#ignore-buttons Button, #fix-all-buttons Button, #reset-buttons Button {
    margin-right: 2;
}

/* Setup page: COURSE and AI MODEL tabs over one framed page each */
#setup-tabs {
    height: 1;
    max-width: 100;
    margin: 1 0 0 0;
}

#setup-tabs Underline {
    display: none;
}

#setup-tabs Tab {
    height: 1;
    padding: 0 1;
}

#setup-tabs Tab.-active {
    background: $accent;
    color: $background;
    text-style: bold;
}

#setup, #setup-ai {
    padding: 1 2;
    max-width: 100;
    border: double $accent;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $accent;
}

#ai-panel {
    height: auto;
}

#ai-provider {
    width: auto;
}

#ai-key-buttons, #ai-model-row, #chat-row, #setup-ai-buttons {
    height: auto;
}

#ai-key-buttons Button, #chat-row Button, #ai-model-row Button {
    margin-left: 1;
}

#ai-key-buttons Button {
    margin: 0 1 0 0;
}

#ai-model, #chat-input {
    width: 1fr;
}

#ai-model-info {
    color: $text-muted;
}

#chat-log {
    height: 12;
    border: round $accent 50%;
    padding: 0 1;
}

.chat-line {
    margin-bottom: 1;
}

/* Always in view: the AI page is taller than most windows */
#setup-ai-buttons {
    dock: bottom;
    padding-top: 1;
    background: $background;
}

KeyDialog, ModelPicker {
    align: center middle;
}

#key-dialog, #model-picker {
    width: 90;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: double $accent;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $accent;
    background: $surface;
}

#key-input {
    margin-top: 1;
}

#key-buttons {
    height: auto;
    margin-top: 1;
}

#key-buttons Button {
    margin-right: 2;
}

#model-status {
    margin: 1 0;
    color: $text-muted;
}

#model-list {
    height: 20;
}

#setup-intro {
    margin-bottom: 1;
}

.setup-section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

#recent {
    height: auto;
    max-height: 8;
}

#editor {
    width: auto;
}

#theme {
    width: 48;
}

#setup-path {
    height: auto;
}

#setup-path Button {
    margin-left: 1;
}

#setup-buttons {
    height: auto;
    margin-top: 1;
}

#course-dir {
    width: 1fr;
}

#setup-error {
    color: $error;
    margin: 1 0;
}
