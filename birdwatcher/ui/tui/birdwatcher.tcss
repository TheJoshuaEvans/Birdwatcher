/* Styles for the Birdwatcher app (Textual CSS). */

/* Findings view */
#findings {
    width: 45%;
}

#detail-scroll {
    width: 1fr;
    padding: 0 1;
}

#excerpt-scroll {
    height: auto;
}

#excerpt {
    width: auto;
}

/* The draggable bar between the findings list and the detail panel. The
   pointer shape shows only in terminals that support it (OSC 22). */
Divider {
    width: 1;
    height: 1fr;
    background: $accent;
    pointer: ew-resize;
}

Divider:hover, Divider.-dragging {
    background: $accent-lighten-2;
}

/* Setup page */
#setup {
    padding: 1 2;
    max-width: 100;
}

#setup-title {
    text-style: bold;
    margin-bottom: 1;
}

#setup-intro {
    margin-bottom: 1;
}

#setup-path {
    height: auto;
}

#course-dir {
    width: 1fr;
}

#setup-error {
    color: $error;
    margin: 1 0;
}
