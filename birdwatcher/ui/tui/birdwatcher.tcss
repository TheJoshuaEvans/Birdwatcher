/* Styles for the Birdwatcher app (Textual CSS). */

/* Findings view */
#findings {
    width: 45%;
}

#detail-scroll {
    width: 1fr;
    padding: 0 1;
}

#excerpt-scroll {
    height: auto;
}

#excerpt {
    width: auto;
}

/* The fix (or suggested fix) and its buttons, under the source lines */
#fix-summary {
    margin-top: 1;
}

#actions {
    height: auto;
    margin-top: 1;
}

#actions Button {
    margin-right: 1;
}

/* The ignore dialog, centred over the findings */
IgnoreDialog {
    align: center middle;
}

#ignore-dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

#ignore-title {
    text-style: bold;
    margin-bottom: 1;
}

#ignore-warning {
    color: $warning;
    text-style: bold;
    margin-top: 1;
}

#ignore-reason-label {
    margin-top: 1;
}

#ignore-buttons {
    height: auto;
    margin-top: 1;
}

#ignore-buttons Button {
    margin-right: 1;
}

/* The draggable bar between the findings list and the detail panel. The
   pointer shape shows only in terminals that support it (OSC 22). */
Divider {
    width: 1;
    height: 1fr;
    background: $accent;
    pointer: ew-resize;
}

Divider:hover, Divider.-dragging {
    background: $accent-lighten-2;
}

/* Setup page */
#setup {
    padding: 1 2;
    max-width: 100;
}

#setup-title {
    text-style: bold;
    margin-bottom: 1;
}

#setup-intro {
    margin-bottom: 1;
}

.setup-section {
    text-style: bold;
    margin-top: 1;
}

#recent {
    height: auto;
    max-height: 8;
}

#editor {
    width: auto;
}

#setup-path {
    height: auto;
}

#setup-buttons {
    height: auto;
}

#course-dir {
    width: 1fr;
}

#setup-error {
    color: $error;
    margin: 1 0;
}
