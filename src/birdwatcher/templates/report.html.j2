<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Birdwatcher report: {{ run.repo }}</title>
<style>
  :root {
    color-scheme: light;
    --page: #f9f9f7;
    --surface: #fcfcfb;
    --ink: #0b0b0b;
    --ink-2: #52514e;
    --muted: #6d6c67;
    --line: #e1e0d9;
    --link: #1c5cab;
    --error: #b3261e;
    --error-bg: #fbe9e7;
    --warning: #7a5200;
    --warning-bg: #fdf1d6;
    --info: #1c5cab;
    --info-bg: #e7f0fc;
    --target: #fff3c2;
    --target-edge: #c98500;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --page: #0d0d0d;
      --surface: #1a1a19;
      --ink: #f0efec;
      --ink-2: #c3c2b7;
      --muted: #a09f98;
      --line: #2c2c2a;
      --link: #86b6ef;
      --error: #f19d97;
      --error-bg: #3a1b19;
      --warning: #f2c66b;
      --warning-bg: #352a12;
      --info: #86b6ef;
      --info-bg: #17263a;
      --target: #3a3214;
      --target-edge: #c98500;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 32px 16px 64px; }
  a { color: var(--link); }
  h1 { font-size: 28px; margin: 0 0 4px; }
  h2 { font-size: 20px; margin: 40px 0 12px; }
  .meta { color: var(--ink-2); margin: 0; }
  code { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 0.92em; }
  .notice {
    margin: 16px 0 0; padding: 10px 14px; border-radius: 8px;
    background: var(--warning-bg); color: var(--warning); border: 1px solid var(--line);
  }
  .totals { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 8px; }
  .badge {
    display: inline-block; padding: 2px 10px; border-radius: 999px;
    font-size: 13px; font-weight: 600; white-space: nowrap;
  }
  .badge.error { background: var(--error-bg); color: var(--error); }
  .badge.warning { background: var(--warning-bg); color: var(--warning); }
  .badge.info { background: var(--info-bg); color: var(--info); }
  .badge.none { background: var(--surface); color: var(--ink-2); border: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  th, td { text-align: left; padding: 10px 14px; border-top: 1px solid var(--line); vertical-align: top; }
  thead th { border-top: none; color: var(--ink-2); font-size: 13px; font-weight: 600; }
  td.number { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .description { display: block; color: var(--ink-2); font-size: 14px; margin-top: 2px; }
  .failed { color: var(--error); font-weight: 600; }
  .filters { display: flex; flex-wrap: wrap; gap: 16px; margin: 0 0 16px; color: var(--ink-2); font-size: 14px; }
  .file { margin: 0 0 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  .file h3 { margin: 0; padding: 12px 16px; font-size: 15px; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  .file h3 .count { color: var(--muted); font-weight: 400; }
  ol { list-style: none; margin: 0; padding: 0; }
  .finding {
    display: grid; grid-template-columns: auto 1fr auto; gap: 4px 12px;
    padding: 12px 16px; border-top: 1px solid var(--line); scroll-margin-top: 24px;
  }
  .finding:first-child { border-top: none; }
  .finding:target { background: var(--target); box-shadow: inset 4px 0 0 var(--target-edge); }
  .finding .where { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .finding .check { color: var(--muted); font-size: 14px; }
  .finding .message { grid-column: 2 / 4; margin: 0; overflow-wrap: anywhere; }
  .finding .permalink { color: var(--muted); text-decoration: none; }
  .empty { padding: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  footer { margin-top: 48px; color: var(--muted); font-size: 14px; }
  [hidden] { display: none !important; }
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>Birdwatcher report</h1>
  <p class="meta">
    <a href="https://github.com/{{ run.repo }}">{{ run.repo }}</a>
    at commit <a href="{{ commit_url }}"><code>{{ short_commit }}</code></a>
    · checked {{ checked_at }}
  </p>
  {% if run.stale %}
  <p class="notice">GitHub could not be reached for this run, so the course files checked here may be out of date.</p>
  {% endif %}
</header>

<main>
  <div class="totals" aria-label="Totals">
    {% for total in totals %}
    <span class="badge {{ total.severity }}">{{ total.count }} {{ total.label }}</span>
    {% else %}
    <span class="badge none">No findings</span>
    {% endfor %}
  </div>

  <h2>Checks</h2>
  <table>
    <thead><tr><th>Check</th><th class="number">Findings</th><th class="number">Time</th></tr></thead>
    <tbody>
    {% for row in checks %}
      <tr>
        <td>
          <strong>{{ row.title }}</strong> <code>{{ row.id }}</code>
          <span class="description">{{ row.description }}</span>
          {% if row.error %}<span class="description failed">Failed: {{ row.error }}</span>{% endif %}
        </td>
        <td class="number">{% if row.error %}–{% else %}{{ row.count }}{% endif %}</td>
        <td class="number">{{ row.seconds }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Findings</h2>
  {% if groups %}
  <div class="filters" id="filters" hidden>
    <span>Show:</span>
    {% for total in totals %}
    <label><input type="checkbox" data-severity="{{ total.severity }}" checked> {{ total.label_plural }}</label>
    {% endfor %}
  </div>
  {% for group in groups %}
  <section class="file">
    <h3><a href="{{ group.url }}">{{ group.path }}</a> <span class="count">({{ group.entries | length }})</span></h3>
    <ol>
    {% for entry in group.entries %}
      <li class="finding" id="{{ entry.anchor }}" data-severity="{{ entry.severity }}">
        <span class="badge {{ entry.severity }}">{{ entry.severity_label }}</span>
        <span>
          <a class="where" href="{{ entry.source_url }}">{% if entry.line %}Line {{ entry.line }}{% else %}Whole file{% endif %}</a>
          <span class="check">· {{ entry.check_title }}</span>
        </span>
        <a class="permalink" href="#{{ entry.anchor }}" title="Link to this finding" aria-label="Link to this finding">#</a>
        <p class="message">{{ entry.message }}</p>
      </li>
    {% endfor %}
    </ol>
  </section>
  {% endfor %}
  {% else %}
  <p class="empty">No findings. Every check came back clean.</p>
  {% endif %}
</main>

<footer>
  Made by <a href="{{ project_url }}">Birdwatcher</a>, which watches course materials for consistency problems and blind spots.
</footer>
</div>
<script>
  (function () {
    var panel = document.getElementById("filters");
    if (!panel) return;
    panel.hidden = false;
    var boxes = panel.querySelectorAll("input[data-severity]");
    function apply() {
      var shown = {};
      boxes.forEach(function (box) { shown[box.dataset.severity] = box.checked; });
      document.querySelectorAll(".finding").forEach(function (item) {
        item.hidden = !shown[item.dataset.severity];
      });
      document.querySelectorAll(".file").forEach(function (section) {
        section.hidden = !section.querySelector(".finding:not([hidden])");
      });
    }
    boxes.forEach(function (box) { box.addEventListener("change", apply); });
  })();
</script>
</body>
</html>
